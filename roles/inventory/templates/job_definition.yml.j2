---
apiVersion: batch/v1
kind: Job
metadata:
  name: "{{ ansible_operator_meta.name }}"
  namespace: "{{ ansible_operator_meta.namespace }}"
spec:
  ttlSecondsAfterFinished: {{ job_ttl }}
  template:
    metadata:
      labels:
        app.kubernetes.io/managed-by: '{{ (ansible_operator_meta.labels | default({})).get("app.kubernetes.io/managed-by", "awx-resource-operator") }}'
        app.kubernetes.io/component: 'awx-resource-runner'
    spec:
      serviceAccountName: resource-operator-controller-manager-job
      containers:
        - name: resource-runner
          image: "{{ _runner_image }}"
          imagePullPolicy: "{{ _runner_pull_policy }}"
          env:
            - name: TOWER_OAUTH_TOKEN
              valueFrom:
                secretKeyRef:
                  name: "{{ connection_secret }}"
                  key: token
            - name: CONTROLLER_OAUTH_TOKEN
              valueFrom:
                secretKeyRef:
                  name: "{{ connection_secret }}"
                  key: token
            - name: TOWER_HOST
              valueFrom:
                secretKeyRef:
                  name: "{{ connection_secret }}"
                  key: host
            - name: CONTROLLER_HOST
              valueFrom:
                secretKeyRef:
                  name: "{{ connection_secret }}"
                  key: host
            - name: RUNNER_RESOURCE_KIND
              value: "AnsibleInventory"
            - name: NAME
              value: "{{ name }}"
            - name: STATE
              value: "{{ state | default('present') }}"
            - name: ORGANIZATION
              value: "{{ organization | default('') }}"
            - name: COPY_FROM
              value: "{{ copy_from | default('') }}"
            - name: DESCRIPTION
              value: "{{ description | default('') }}"
            - name: INSTANCE_GROUPS
              value: '{{ instance_groups | default([]) | to_json | replace("'", "''") }}'
            - name: VARIABLES
              value: '{{ variables | default({}) | to_json | replace("'", "''") }}'
            - name: GROUPS
              value: '{{ _inventory_groups | default([]) | to_json | replace("'", "''") }}'
            - name: TOWER_VERIFY_SSL
              value: "False"
            - name: CONTROLLER_VERIFY_SSL
              value: "False"
            - name: RUNNER_RESOURCE_GENERATION
              value: "{{ ansible_operator_meta.generation }}"
            - name: RUNNER_RESOURCE_NAME
              value: "{{ ansible_operator_meta.name }}"
            - name: RUNNER_RESOURCE_NAMESPACE
              value: "{{ ansible_operator_meta.namespace }}"
      restartPolicy: Never
  backoffLimit: {{ backoff_limit }}
