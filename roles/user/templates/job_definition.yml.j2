---
apiVersion: batch/v1
kind: Job
metadata:
  name: "{{ ansible_operator_meta.name }}"
  namespace: "{{ ansible_operator_meta.namespace }}"
spec:
  ttlSecondsAfterFinished: {{ job_ttl }}
  template:
    metadata:
      labels:
        app.kubernetes.io/managed-by: '{{ (ansible_operator_meta.labels | default({})).get("app.kubernetes.io/managed-by", "awx-resource-operator") }}'
        app.kubernetes.io/component: 'awx-resource-runner'
    spec:
      serviceAccountName: resource-operator-controller-manager-job
      containers:
        - name: resource-runner
          image: "{{ _runner_image }}"
          imagePullPolicy: "{{ _runner_pull_policy }}"
          env:
            - name: TOWER_OAUTH_TOKEN
              valueFrom:
                secretKeyRef:
                  name: "{{ connection_secret }}"
                  key: token
            - name: CONTROLLER_OAUTH_TOKEN
              valueFrom:
                secretKeyRef:
                  name: "{{ connection_secret }}"
                  key: token
            - name: TOWER_HOST
              valueFrom:
                secretKeyRef:
                  name: "{{ connection_secret }}"
                  key: host
            - name: CONTROLLER_HOST
              valueFrom:
                secretKeyRef:
                  name: "{{ connection_secret }}"
                  key: host
            - name: RUNNER_RESOURCE_KIND
              value: "AnsibleUser"
            - name: USERNAME
              value: "{{ username }}"
            - name: STATE
              value: "{{ state | default('present') }}"
            - name: FIRST_NAME
              value: "{{ first_name | default('') }}"
            - name: LAST_NAME
              value: "{{ last_name | default('') }}"
            - name: EMAIL
              value: "{{ email | default('') }}"
            - name: ORGANIZATION
              value: "{{ organization | default('') }}"
{% if is_superuser is defined %}
            # Only emitted when the user explicitly sets is_superuser, so the
            # operator never demotes an existing superuser by accident.
            - name: IS_SUPERUSER
              value: "{{ is_superuser }}"
{% endif %}
{% if is_system_auditor is defined %}
            # Only emitted when the user explicitly sets is_system_auditor.
            - name: IS_SYSTEM_AUDITOR
              value: "{{ is_system_auditor }}"
{% endif %}
{% if password_secret is defined and password_secret != "" %}
            - name: PASSWORD
              valueFrom:
                secretKeyRef:
                  name: "{{ password_secret }}"
                  key: password
{% endif %}
            - name: TOWER_VERIFY_SSL
              value: "False"
            - name: CONTROLLER_VERIFY_SSL
              value: "False"
            - name: RUNNER_RESOURCE_GENERATION
              value: "{{ _resource_generation | default(1) }}"
            - name: RUNNER_RETRY_COUNT
              value: "{{ (resource_info.resources[0].status.retryCount | default(0) | int) + 1 }}"
            - name: RUNNER_RESOURCE_NAME
              value: "{{ ansible_operator_meta.name }}"
            - name: RUNNER_RESOURCE_NAMESPACE
              value: "{{ ansible_operator_meta.namespace }}"
      restartPolicy: Never
  backoffLimit: {{ backoff_limit }}
